    {
      "id": "folder-user",
      "name": "module user",
      "description": "Quản lý nhân viên và khách hàng",
      "order": [
        "req-user-create",
        "req-user-getall",
        "req-user-paginate",
        "req-user-update",
        "req-user-delete"
      ]
    },
    {
      "id": "folder-upload",
