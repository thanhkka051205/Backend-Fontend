{
  "id": "nest-nestjs-v1-phone-store-collection",
  "name": "Backend Phone Store Ultimate (NodeJS)",
  "description": "Collection chuẩn cấu trúc API quản lý cửa hàng bán điện thoại với tiền tố /api/v1 chạy cổng 8080",
  "order": [],
