# Port chạy ứng dụng backend
PORT=3000

# Môi trường node.js (development hoặc production)
NODE_ENV=production

# URL MongoDB (Đã thêm tên database mặc định phía sau dấu gạch chéo, ví dụ: my_database)
MONGO_DB_URL=mongodb://localhost:27017/my_database

# Mật khẩu mặc định khi tạo fake data cho user
MIGRATION_USER_PASSWORD=123456

# JWT Cấu hình bảo mật
# Chuỗi secret key ngẫu nhiên có độ bảo mật cao (64 ký tự hex)
JWT_ACCESS_SECRET=9b1deb4d3b35c9b4e3aa4f14d3f572fb4d01b1c6e12e737c0c1b489d7008cfc2

# Thời hạn hết hạn của Access Token (Khuyên dùng: 15 phút đến 1 tiếng)
JWT_ACCESS_EXPIRES_IN=1h

# (Tùy chọn bổ sung) Cấu hình cho Refresh Token nếu bạn làm tính năng Remember Me / Đăng nhập lâu dài
JWT_REFRESH_SECRET=7f516a8bcfd25d0c75bc9a3df7a6b29d10e5296bf3e284a1d507fc36d90a7863
JWT_REFRESH_EXPIRES_IN=1000d
