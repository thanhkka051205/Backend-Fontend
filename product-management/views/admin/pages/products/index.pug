extends ../../layouts/default.pug

block main
  h1 Danh sách sản phẩm

  table.table.table-hover.table-sm
    thead
      tr
        th STT
        th Hình ảnh
        th Tiêu đề
        th Giá
        th Trạng thái
        th Hành động
    tbody
      tr
        td 1
        td
          img(
            src="https://cdn.dummyjson.com/product-images/beauty/essence-mascara-lash-princess/thumbnail.webp", 
            alt="Essence Mascara Lash Princess", 
            width="50px", 
            height="auto"
          )
        td Essence Mascara Lash Princess
        td $9.99
        td
          span.badge.badge-success Hoạt động
        td
          a.btn.btn-sm.btn-warning(href="/admin/products/edit/1") Sửa
          a.btn.btn-sm.btn-danger(href="/admin/products/delete/1") Xóa

      tr
        td 2
        td
          img(
            src="https://cdn.dummyjson.com/product-images/beauty/eyeshadow-palette-with-mirror/thumbnail.webp", 
            alt="Eyeshadow Palette with Mirror", 
            width="50px", 
            height="auto"
          )
        td Eyeshadow Palette with Mirror
        td $19.99
        td
          span.badge.badge-danger Ngừng hoạt động
        td
          a.btn.btn-sm.btn-warning(href="/admin/products/edit/2") Sửa
          a.btn.btn-sm.btn-danger(href="/admin/products/delete/2") Xóa