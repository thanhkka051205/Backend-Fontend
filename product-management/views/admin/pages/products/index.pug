extends ../../layouts/default.pug

block main
  h1 Danh sách sản phẩm

  table.table.table-hover.table-sm
    thead
      tr
        th STT
        th Hình ảnh
        th Tiêu đề
        th Giá
        th Trạng thái
        th Hành động
    tbody
      each item, index in products
        tr
          td #{index + 1}
          td
            img(
              src= item.thumbnail, 
              alt= item.title, 
              width="50px", 
              height="auto"
            )
          td #{item.title}
          td #{item.price}$
          td
            if(item.status === "active")
              span.badge.bg-success Hoạt động
            else if(item.status === "inactive")
              span.badge.bg-secondary Không hoạt động
            else
              span.badge.bg-warning Hết hàng
          td
            button.btn.btn-sm.btn-warning(href="/admin/products/edit/1") Sửa
            button.btn.btn-sm.btn-danger(href="/admin/products/delete/1") Xóa
